APP_NAME="LIV RetroSphere"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=retro-mysql
DB_PORT=3306
DB_DATABASE=retro_sphere
DB_USERNAME=retro_user
DB_PASSWORD=retro_password
DB_ROOT_PASSWORD=retro_root_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=retro-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=retro-mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@retrosphere.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_PORT=8090
DB_FORWARD_PORT=3390
VITE_PORT=5173
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

USER_ID=1000
GROUP_ID=1000

#JWT Token
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Login
AUTH_RATE_LIMIT_LOGIN_IP_MAX_ATTEMPTS=20
AUTH_RATE_LIMIT_LOGIN_IP_DECAY_SECONDS=60

AUTH_RATE_LIMIT_LOGIN_FAILED_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_LOGIN_FAILED_DECAY_SECONDS=60

# Registration
AUTH_RATE_LIMIT_REGISTER_SHORT_MAX_ATTEMPTS=3
AUTH_RATE_LIMIT_REGISTER_SHORT_DECAY_SECONDS=600

AUTH_RATE_LIMIT_REGISTER_DAILY_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_REGISTER_DAILY_DECAY_SECONDS=86400

# Token and session operations
AUTH_RATE_LIMIT_REFRESH_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_REFRESH_DECAY_SECONDS=60

AUTH_RATE_LIMIT_LOGOUT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_LOGOUT_DECAY_SECONDS=60

AUTH_RATE_LIMIT_LOGOUT_ALL_MAX_ATTEMPTS=3
AUTH_RATE_LIMIT_LOGOUT_ALL_DECAY_SECONDS=300

# General authenticated API
API_RATE_LIMIT_AUTHENTICATED_MAX_ATTEMPTS=120
API_RATE_LIMIT_AUTHENTICATED_DECAY_SECONDS=60